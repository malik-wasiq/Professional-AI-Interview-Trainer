OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=your_chosen_model_here

# Flask session signing key. Required -- the app will not start without it.
# Generate a real random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-in-production

# Set to "true" only for local development to enable Flask's debugger/reloader.
# Must be unset or "false" in production.
FLASK_DEBUG=false
